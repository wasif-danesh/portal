# Public canonical URL (used for canonical links, sitemap, RSS, OG images)
NEXT_PUBLIC_SITE_URL=https://wasifyai.com

# Contact form: Formspree form id (https://formspree.io/f/<id>). If empty, the form is hidden
# and visitors are shown the email address instead.
FORMSPREE_ID=

# Public contact email shown on the site
NEXT_PUBLIC_CONTACT_EMAIL=wasif.danesh@gmail.com

# Optional Google Tag Manager container id (e.g. GTM-XXXXXXX). Empty = no analytics loaded.
NEXT_PUBLIC_GTM_ID=
